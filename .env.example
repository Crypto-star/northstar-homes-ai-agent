# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Model used for the sales agent and the analytics extraction pass.
MODEL=qwen/qwen3.6-27b
# ANALYTICS_MODEL=qwen/qwen3.6-27b

# Qwen3.6 emits <think> blocks by default; "none" disables them for lower latency.
# Groq accepts only "none" or "default".
REASONING_EFFORT=none
TEMPERATURE=0.4
MAX_TOKENS=700

# Comma-separated allowed origins for the browser UI.
# Use your GitHub Pages origin in production, e.g. https://<user>.github.io
CORS_ORIGINS=*

# Set to 1 to make every site-visit booking fail — used to demo the failure path.
FORCE_BOOKING_FAILURE=0
